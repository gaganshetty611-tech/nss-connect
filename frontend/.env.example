# Leave as /api to use the Vite proxy (recommended: same origin, works through one tunnel URL).
VITE_API_URL=/api
# Where the Vite dev proxy forwards /api and /media
BACKEND_URL=http://127.0.0.1:8000
# Example for a separately hosted API (requires JWT_COOKIE_SAMESITE=None + HTTPS on the backend):
# VITE_API_URL=https://api.your-domain.com/api

# Public URL of the deployed site (used for sitemap.xml, robots.txt, canonical + social-preview URLs)
VITE_SITE_URL=https://your-domain.com
# Optional Google Analytics 4 measurement ID (G-XXXXXXXXXX). Only loaded AFTER the visitor accepts cookies.
# This is a public identifier, not a secret. Leave empty to disable analytics.
VITE_GA_ID=
# Contact address shown on the Privacy/Terms pages
VITE_CONTACT_EMAIL=support@your-domain.com
