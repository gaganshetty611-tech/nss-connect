# ─────────────────────────────────────────────────────────────────────────────
# NSS Connect – environment configuration
# Copy to `.env` in the project root (read by Django) and adjust.
# The frontend reads VITE_* variables from frontend/.env (see frontend/.env.example).
# ─────────────────────────────────────────────────────────────────────────────

# --- Core -------------------------------------------------------------------
# REQUIRED when DEBUG=False. python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=
# True for local development
DEBUG=False
# optional; defaults to SECRET_KEY
JWT_SIGNING_KEY=
TIME_ZONE=Asia/Kolkata

# --- Database ---------------------------------------------------------------
# Empty → SQLite (backend/db.sqlite3). Set → PostgreSQL.
# postgres://nss:password@localhost:5432/nss_connect
DATABASE_URL=

# --- Hosts / CORS / CSRF ------------------------------------------------------
# add .trycloudflare.com or your domain
ALLOWED_HOSTS=localhost,127.0.0.1
# only needed if the SPA is on a different origin
CORS_ALLOWED_ORIGINS=http://localhost:5173
# e.g. https://nss.your-domain.com (Django admin over HTTPS)
CSRF_TRUSTED_ORIGINS=
# public URL of the React app used in emails/QR codes; empty = use request Origin
FRONTEND_URL=

# --- Security (production) ---------------------------------------------------
# True if Django itself terminates HTTPS
SECURE_SSL_REDIRECT=False
# e.g. 31536000 once HTTPS is permanent
SECURE_HSTS_SECONDS=0
# default: True when DEBUG=False
JWT_COOKIE_SECURE=
# None only for cross-site SPA + API (requires HTTPS)
JWT_COOKIE_SAMESITE=Lax
REQUIRE_EMAIL_VERIFICATION=True

# --- Email --------------------------------------------------------------------
# Leave EMAIL_HOST empty to print emails to the console (development).
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
# use an app password / SMTP key, never an account password
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=NSS Connect <no-reply@your-domain.com>

# --- Google OAuth 2.0 (optional) -----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# e.g. http://localhost:5173/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- AI -----------------------------------------------------------------------
# rule_based | openai | gemini (falls back to rule_based without a key)
AI_PROVIDER=rule_based
OPENAI_API_KEY=
GEMINI_API_KEY=
# JSON, e.g. {"distance":0.25,"skills":0.2,"availability":0.2,"attendance":0.2,"interest":0.15}
AI_MATCH_WEIGHTS=
AI_MAX_DISTANCE_KM=50

# --- Attendance rules -----------------------------------------------------------
ATTENDANCE_EARLY_CHECKIN_MINUTES=60
ATTENDANCE_LATE_AFTER_MINUTES=15
ATTENDANCE_CHECKOUT_GRACE_MINUTES=120
# Minimum minutes between check-in and check-out (guards against accidental double scans)
ATTENDANCE_MIN_MINUTES=15

# --- Frontend -------------------------------------------------------------------
# (frontend/.env) '/api' = same origin via Vite proxy or Django-served build
VITE_API_URL=/api

# --- Media / storage ----------------------------------------------------------------
# default backend/media
MEDIA_ROOT=
MEDIA_URL=/media/
# Django serves public uploads (fine for a demo; use nginx/S3 at scale)
SERVE_MEDIA=True
MAX_IMAGE_UPLOAD_SIZE=5242880
MAX_DOCUMENT_UPLOAD_SIZE=10485760
# Optional S3-compatible storage (pip install django-storages boto3)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Rate limits ---------------------------------------------------------------------
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AUTH=20/min
THROTTLE_CHECKIN=30/min
